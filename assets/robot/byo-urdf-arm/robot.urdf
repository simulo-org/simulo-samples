<?xml version="1.0"?>
<robot name="byo_urdf_arm">
  <!-- A three-joint desktop arm: mesh geometry, link masses and inertia tensors,
       and revolute joints with limits and damping. base_link is the root, so the
       arm is bolted down rather than free-floating. Change the numbers, swap the
       meshes, or replace this file with your own robot and publish again. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.000000 0.000000 0.030000" rpy="0 0 0"/>
      <mass value="1.500000"/>
      <inertia ixx="0.00158114" ixy="-0.00000000" ixz="0.00000000" iyy="0.00158114" iyz="-0.00000000" izz="0.00226228"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_link.stl" scale="1 1 1"/></geometry>
      <material name="base_link_mat"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_link.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>
  <link name="link1">
    <inertial>
      <origin xyz="0.000000 0.000000 0.060000" rpy="0 0 0"/>
      <mass value="0.500000"/>
      <inertia ixx="0.00075269" ixy="-0.00000000" ixz="0.00000000" iyy="0.00075269" iyz="-0.00000000" izz="0.00030538"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link1.stl" scale="1 1 1"/></geometry>
      <material name="link1_mat"><color rgba="0.2 0.45 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link1.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>
  <link name="link2">
    <inertial>
      <origin xyz="0.000000 0.000000 0.060000" rpy="0 0 0"/>
      <mass value="0.350000"/>
      <inertia ixx="0.00049853" ixy="-0.00000000" ixz="0.00000000" iyy="0.00049853" iyz="0.00000000" izz="0.00015705"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link2.stl" scale="1 1 1"/></geometry>
      <material name="link2_mat"><color rgba="0.2 0.6 0.55 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link2.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>
  <link name="link3">
    <inertial>
      <origin xyz="0.000000 0.000000 0.045000" rpy="0 0 0"/>
      <mass value="0.200000"/>
      <inertia ixx="0.00016372" ixy="-0.00000000" ixz="0.00000000" iyy="0.00016372" iyz="0.00000000" izz="0.00005744"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link3.stl" scale="1 1 1"/></geometry>
      <material name="link3_mat"><color rgba="0.8 0.55 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link3.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>
  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.060000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6000" upper="2.6000" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.120000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9000" upper="1.9000" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.120000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2000" upper="2.2000" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
</robot>
